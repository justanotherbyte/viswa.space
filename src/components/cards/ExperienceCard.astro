---
interface Props { position: string; company: string; companyLink: string; startDate: string; endDate: string; companyLogo: string; description: string; }
const { position, company, companyLink, startDate, endDate, description } = Astro.props;
---
<div class="experience-card"><div class="experience-date"><i class="signal-dot"></i>{startDate} — {endDate}</div><a href={companyLink} target="_blank" rel="noopener noreferrer"><h3>{company} <span aria-hidden="true">↗</span></h3></a><p class="experience-role">{position}</p><p class="experience-description">{description}</p></div>
