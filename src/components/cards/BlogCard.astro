---
interface Props { name: string; description: string; slug: string; }
const { name, description, slug } = Astro.props;
---
<a href={`/publications/${slug}`} class="transmission-card"><span class="card-meta">FIELD NOTES <span aria-hidden="true">↗</span></span><h3>{name}</h3><p>{description}</p><span class="card-link">Read transmission ↗</span></a>
