---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title: string; description: string; image: ImageMetadata | string; imagePosition?: 'top' | 'center' | 'bottom'; readingTime: string; slug: string; }
const { title, description, image, imagePosition = 'center', readingTime, slug } = Astro.props;
const category = ({ 'vega-ksp': 'ROCKETRY / GROUND SYSTEMS', 'fpga-itch-parser': 'HARDWARE / FPGA' } as Record<string, string>)[slug] ?? 'ENGINEERING / PROJECT';
---
<a href={`/projects/${slug}`} class="project-card">
  <div class="project-image" style={`--image-position: ${imagePosition}`}>
    {typeof image === 'string' ? <img src={image} alt={title} loading="lazy" /> : <Image src={image} alt={title} width={900} loading="lazy" />}
    <span class="project-category">{category}</span><span class="project-arrow" aria-hidden="true">↗</span>
  </div>
  <div class="project-content"><p class="card-meta">MISSION DOSSIER <span>{readingTime}</span></p><h3>{title}</h3><p>{description}</p><span class="card-link">Explore project <span aria-hidden="true">↗</span></span></div>
</a>
