---
// stroked 24px line icons, drawn in the current text colour
const icons = {
	terminal: '<path d="M4 17l6-6-6-6"/><path d="M12 19h8"/>',
	chip: '<rect x="5" y="5" width="14" height="14"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/>',
	rocket: '<path d="M12 2c2.8 2.2 4 5.6 4 9.5V18H8v-6.5C8 7.6 9.2 4.2 12 2z"/><path d="M8 13l-3 3v4h3M16 13l3 3v4h-3"/><circle cx="12" cy="9" r="1.5"/><path d="M11 21h2"/>',
	arm: '<path d="M3 21h11M5 21v-3h7v3"/><circle cx="8.5" cy="14.5" r="1.5"/><path d="M9.2 13.2l3.3-6.4"/><circle cx="13" cy="5.5" r="1.5"/><path d="M14.4 6.1l4.6 2.4"/><path d="M19 8.5l2-2M19 8.5l2 2"/>',
	atom: '<circle cx="12" cy="12" r="1.2"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>',
	mail: '<rect x="2" y="4" width="20" height="16"/><path d="M22 6l-10 7L2 6"/>',
	file: '<path d="M14 2H5v20h14V7z"/><path d="M14 2v5h5M8 13h8M8 17h5"/>',
	github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
	linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
	x: '<path d="M4 4l11.7 16H20L8.3 4z"/><path d="M4 20l6.8-6.8M13.2 10.8L20 4"/>',
};

interface Props {
	name: keyof typeof icons;
	class?: string;
}

const { name, class: className = 'w-4 h-4' } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={icons[name]}
/>
