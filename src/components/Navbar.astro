---
import { MY_EMAIL } from '../consts';
const links = [{ href: '/#aboutme', label: 'About' }, { href: '/projects', label: 'Projects' }, { href: '/publications', label: 'Flight log' }, { href: '/photography', label: 'Photography' }];
---
<nav class="site-nav" id="top" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="wordmark" aria-label="Viswa Marepalli home"><span class="mission-mark" aria-hidden="true">V<span>↗</span></span><span>VISWA<span class="wordmark-space">.SPACE</span></span></a>
    <button id="navbar-toggle" class="nav-toggle" type="button" aria-controls="navbar-default" aria-expanded="false">Menu <span aria-hidden="true">+</span></button>
    <div id="navbar-default" class="nav-links">
      {links.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      <a href="/data/cv.pdf">CV ↗</a>
      <a class="nav-contact" href={`mailto:${MY_EMAIL}`}>Get in touch <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</nav>
<script>
  const toggle = document.getElementById('navbar-toggle');
  const menu = document.getElementById('navbar-default');
  function setOpen(open: boolean) {
    menu?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); } });
  matchMedia('(min-width: 900px)').addEventListener('change', () => setOpen(false));
</script>
