			};

			let live = false, woken = false;
			new IntersectionObserver(([e]) => {
				live = e.isIntersecting;
				wrap.classList.toggle('is-live', live);
				cancelAnimationFrame(raf);
				last = 0;
				if (live) raf = requestAnimationFrame(ride);
				// the first time the footer comes into view the engine warms and the slopes' circuits wake one after another
				if (live && !woken) {
					woken = true;
					wrap.classList.add('awake');
					routes.slice(0, 7).forEach((r, i) => setTimeout(() => comet(r, 60, pulses), 500 + i * 260));
				}
			}, { threshold: 0.2 }).observe(wrap);
			// after that: a slow pulse down a slope every few seconds, and now and then a signal hops along a constellation
			setInterval(() => live && !document.hidden && routes.length && comet(pick(routes), 34, pulses), 3600);
			setInterval(() => live && !document.hidden && wires.length && comet(pick(wires), 28, skyPulses, 'comet sky'), 7300);
		}
	}
</script>
