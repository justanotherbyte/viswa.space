---
// A mountain range under a starry sky, and on a closer look an imaginary circuit: the rock is routed copper, the stars
// are wired together, and rocket hardware has weathered into the geology. Stacked SVGs share one viewBox so each layer
// can move on its own for parallax.
import { W, H, land, far, tracks, fire, nosecone, ring } from '../lib/footerScene';
import { sky } from '../lib/footerSky';
import { pose, trail } from '../lib/footerRide';

const vb = `0 0 ${W} ${H}`;
// the rocket's flame, hanging below the base of the cone: three layers from a wide dim sheath to a pale core
const FLAME = (() => {
	const [cx, by, hw] = nosecone.base;
	return [[0.62, 200], [0.4, 140], [0.2, 74]].map(([w, L]) => `M${cx - hw * w} ${by}Q${cx - hw * w * 0.9} ${by + L * 0.45} ${cx} ${by + L}Q${cx + hw * w * 0.9} ${by + L * 0.45} ${cx + hw * w} ${by}Z`);
})();
const PROBED = ['h-near', 'h-mid', 'b-near', 'b-mid', 'e-near', 'e-mid'].filter((c) => land.paths[c]); // the routed copper, not the far contours
const { circuit } = sky;

// dirt bikers on the sand: three riding the long lap together, one carving a figure of eight by the dunes
const RIDERS = [
	{ track: 0, at: 0.02, speed: 46 },
	{ track: 0, at: 0.05, speed: 47 },
	{ track: 0, at: 0.085, speed: 45 },
	{ track: 1, at: 0.35, speed: 34 },
];
// a rider on a motocross bike in side view, facing +x with the tyres on y = 0, about ten units long
const BIKE = {
	wheels: ring(-3.4, -1.6, 1.6) + ring(3.6, -1.6, 1.6),
	frame: 'M-3.4 -1.6L-.4 -2.7M-.9 -2.3h2.3v-1.1h-2.3zM3.6 -1.6L2.3 -5M1.9 -5.2h1.1M-3.7 -4.1H-1l2-.6 1.4.2M-5 -3.6l1.3-.5M3 -3.7l1.7.2',
	rider: 'M-.6 -4.8L.6 -7.4M.6 -7.1L2.2 -5.3M-.6 -4.8L.9 -3.5-.1 -2.5' + ring(0.9, -8.4, 0.95) + 'M1.4 -8.6h.9',
	beam: 'M3.4 -4.5L11 -6.2V-3.2Z',
};
---

<div id="launch-art" class="art-wrap" aria-hidden="true">
	<svg class="lyr" data-depth="0" viewBox={vb} preserveAspectRatio="xMidYMax slice">
		<path d={sky.milky[0]} class="t-faint-fill" />
		<path d={sky.milky[1]} class="t-dist-fill" />
		<path d={sky.stars[0]} class="t-dist-fill" />
		<path d={sky.stars[1]} class="t-sec-fill" />
		<path d={sky.stars[2]} class="t-pri2-fill" />
		{sky.sparkles.map((s) => <path d={`M${s.x - s.s} ${s.y + 0.5}h${s.s * 2 + 1}M${s.x + 0.5} ${s.y - s.s}v${s.s * 2 + 1}`} class="spark" />)}
		{sky.leds.map((s) => <rect class={s.amber ? 'led amber' : 'led'} x={s.x} y={s.y} width="1.5" height="1.5" style={`animation-delay:-${s.d}s`} />)}
		<g class="circuit">
			{circuit.lines.map((d, i) => <path d={d} class="cn" style={`animation-delay:-${i * 9}s`} />)}
			{circuit.syms.map((s) => <path d={s.d} transform={s.t} class="sym" />)}
			<path d={circuit.nodes} class="node" />
			<path d={circuit.pads} class="cpad" />
			{circuit.dots.map((p) => <rect x={p.x} y={p.y} width="1.5" height="1.5" class="cdot" style={`animation-delay:-${p.d}s`} />)}
			<g class="sky-pulses"></g>
		</g>
		{sky.twinkles.map((s) => <rect x={s.x} y={s.y} width="1.2" height="1.2" class="tw" style={`--t:${s.t}s;animation-delay:-${s.d}s`} />)}
	</svg>

	<svg class="lyr" data-depth="4" viewBox={vb} preserveAspectRatio="xMidYMax slice">
		<path d={far.fill} class="mask" />
		<path d={far.hatch} class="t-faint" />
		<path d={far.edge} class="far-edge" />
	</svg>

	<svg class="lyr" data-depth="9" viewBox={vb} preserveAspectRatio="xMidYMax slice">
		<path d={land.mask} class="mask" />
		{Object.entries(land.paths).map(([c, d]) => <path d={d} class={c} id={`cu-${c}`} />)}
		<path d={land.vias.mid} class="via mid" id="cu-via-mid" />
		<path d={land.vias.near} class="via" id="cu-via" />
		<path d={land.pads} class="pad" id="cu-pad" />
		<path d={land.junctions} class="junction" id="cu-junction" />
		{Object.entries(land.hw).map(([c, d]) => c !== 'lip' && <path d={d} class={c} />)}
		<path d={land.pipe} class="pipe" />
		<path d={land.ics} class="ic" />
	</svg>

	{/* everything that moves lives in its own layer over the land, so the land's thousands of traces are painted once
	   and never again while the pulses, riders, probe light, launch and burn animate */}
	<svg class="lyr overlay" data-depth="9" viewBox={vb} preserveAspectRatio="xMidYMax slice">
		{/* the probe light: the copper under the pointer, warmed, in a pool that fades at its edge */}
		<defs>
			<radialGradient id="probe-fade"><stop offset="0.35" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
			<mask id="probe-mask" maskUnits="userSpaceOnUse" x="-292" y="-292" width="184" height="184"><circle id="probe" cx="-200" cy="-200" r="92" fill="url(#probe-fade)" /></mask>
		</defs>
		<g class="probe" mask="url(#probe-mask)">
			{[...PROBED.map((c) => `cu-${c}`), 'cu-via-mid', 'cu-via', 'cu-pad', 'cu-junction'].map((id) => <use href={`#${id}`} />)}
		</g>
		{/* the nose cone is the tip of a buried rocket: click it and the peak launches */}
		<g class="rocket" data-base={nosecone.base.join(' ')} style={`transform-origin:${nosecone.base[0]}px ${nosecone.base[1]}px`}>
			<g class="exhaust">{FLAME.map((d, i) => <path d={d} class={`fl fl${i}`} />)}</g>
			<path d={nosecone.body} class="rocket-body" />
			{(['left', 'right'] as const).map((side) => Object.entries(nosecone[side]).map(([c, d]) => <path d={d} class={c} />))}
		</g>
		<ellipse class="nose-hit" {...nosecone.hit} />
		{/* the static fire: hidden until someone clicks the mouth of the engine */}
		<defs>
			<linearGradient id="plume-fade" gradientUnits="userSpaceOnUse" {...fire.fade}><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
			{/* ignition unrolls the jet left to right out of the mouth behind a soft edge that sweeps sideways */}
			<linearGradient id="unroll-edge" gradientUnits="userSpaceOnUse" x1={fire.wipe + W} y1="0" x2={fire.wipe + W + 140} y2="0">
				<stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
				<animate class="unroll" attributeName="x1" from={fire.wipe - 140} to={fire.wipe + W} dur="1s" begin="indefinite" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.16 1 0.3 1" />
				<animate class="unroll" attributeName="x2" from={fire.wipe} to={fire.wipe + W + 140} dur="1s" begin="indefinite" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.16 1 0.3 1" />
			</linearGradient>
			<mask id="plume-unroll" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}><rect width={W} height={H} fill="url(#unroll-edge)" /></mask>
			<mask id="plume-mask" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}><rect width={W} height={H} fill="url(#plume-fade)" /></mask>
		</defs>
		<g class="plume" mask="url(#plume-unroll)">
			<g class="flame" mask="url(#plume-mask)">
				{fire.layers.map((d, i) => <path d={d} class={`fl fl${i}`} />)}
				<g class="streams">{fire.streams.map((d, i) => <path d={d} style={`animation-delay:-${(i * 0.07).toFixed(2)}s`} />)}</g>
			</g>
			<path d={fire.diamonds} class="diamond" />
		</g>
		<path d={land.hw.lip} class="lip" />
		<g class="debris" data-cliff={JSON.stringify(fire.cliff)} data-mouth={fire.mouth.join(' ')}></g>
		<ellipse class="mouth-hit" {...fire.hit} />
		<g class="pulses">{land.routes.map((d) => <path d={d} class="route" />)}</g>
		<g class="riders" data-tracks={JSON.stringify(tracks)}>
			{RIDERS.map((r) => {
				const t = tracks[r.track], p = pose(t, r.at);
				return (
					<g class="rider" data-track={r.track} data-at={r.at} data-speed={r.speed}>
						<path d={trail(t, r.at, 90)} class="tyre" />
						<path d={trail(t, r.at, 30)} class="tyre fresh" />
						<g class="bike" transform={p.transform} opacity={p.opacity}>
							<path d={BIKE.beam} class="beam" />
							<path d={BIKE.wheels} class="wheel" vector-effect="non-scaling-stroke" />
							<path d={BIKE.frame} class="frame" vector-effect="non-scaling-stroke" />
							<path d={BIKE.rider} class="frame" vector-effect="non-scaling-stroke" />
							<rect x="2.9" y="-4.9" width=".8" height=".8" class="lamp" />
						</g>
					</g>
				);
			})}
		</g>
	</svg>
</div>

<style>
	.art-wrap {
		position: relative;
		overflow: hidden;
		margin-top: 2rem;
		height: clamp(300px, 35vw, 700px);
		--bg: #18181b;
		--pri: #e0e2e8;
		--pri2: #b8bbc7;
		--sec: #777c91;
		--dist: #454b63;
		--faint: #2c303b;
		--amber: #f59e42;
		--blue: #6599ed;
		--sun0: #ffd49a;
		--sun3: #a4602b;
		--sun4: #6a4024;
	}
	@media (max-width: 639px) {
		.art-wrap { height: min(118vw, 520px); }
	}
	@media (prefers-color-scheme: light) {
		.art-wrap {
			--bg: #fff;
			--pri: #18181b;
			--pri2: #3f3f46;
			--sec: #71717a;
			--dist: #a1a1aa;
			--faint: #d4d4d8;
			--amber: #d97706;
			--blue: #2563eb;
			--sun0: #f59e0b;
			--sun3: #f2b36b;
			--sun4: #f7d3a6;
		}
	}
	.lyr {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		fill: none;
		stroke-width: 0.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.art-wrap.near .lyr { will-change: transform; }
	.t-faint { stroke: var(--faint); }
	.t-faint-fill { fill: var(--faint); }
	.t-dist-fill { fill: var(--dist); }
	.t-sec-fill { fill: var(--sec); }
	.t-pri2-fill { fill: var(--pri2); }
	.mask { fill: var(--bg); stroke: none; }

	/* sky */
	.spark { stroke: var(--pri2); stroke-width: 0.5; }
	.led { fill: var(--pri2); animation: led 11s steps(1, end) infinite; }
	.led.amber { fill: var(--amber); }
	.cn { stroke: var(--faint); stroke-width: 0.45; animation: wake 27s steps(24, end) infinite; }
	.sym { stroke: var(--dist); stroke-width: 0.45; }
	.node { stroke: var(--dist); stroke-width: 0.45; }
	.cpad { stroke: var(--dist); stroke-width: 0.45; fill: var(--bg); }
	.cdot { fill: var(--pri2); animation: twinkle 6s steps(10, end) infinite; }
	.tw { fill: var(--pri2); animation: twinkle var(--t) steps(10, end) infinite; }
	.far-edge { stroke: var(--dist); stroke-width: 0.5; }

	/* the land: rock as copper, a step brighter as it comes nearer; hardware in its own machined hairline */
	.r-far { stroke: var(--faint); stroke-width: 0.45; }
	.i-far { stroke: var(--dist); stroke-width: 0.45; }
	.e-far { stroke: var(--dist); stroke-width: 0.5; }
	.e-mid { stroke: var(--ink, var(--sec)); stroke-width: 0.55; }
	.e-near { stroke: var(--ink, var(--sec)); stroke-width: 0.6; }
	.e-hw, .lip { stroke: var(--pri2); stroke-width: 0.55; }
	.g { stroke: var(--dist); stroke-width: 0.6; stroke-dasharray: 0.6 4.4; }
	.s-mid { stroke: var(--faint); stroke-width: 0.45; }
	.s-near { stroke: var(--faint); stroke-width: 0.5; }
	.h-mid { stroke: var(--ink, var(--dist)); stroke-width: 0.45; }
	.h-near { stroke: var(--ink, var(--sec)); stroke-width: 0.55; }
	.tube { stroke: var(--dist); stroke-width: 0.4; }
	.band { stroke: var(--sec); stroke-width: 0.5; }
	.hot { stroke: var(--amber); stroke-width: 0.6; transition: opacity 3s ease-in; }
	/* the throat is cold until the footer first comes into view; without script or with reduced motion it stays warm */
	#launch-art.armed:not(.awake) .hot { opacity: 0.25; }
	.inner { stroke: var(--dist); stroke-width: 0.4; }
	.inner-warm { stroke: var(--sun4); stroke-width: 0.4; }
	.rivet { fill: var(--sec); }
	.b-mid { stroke: var(--ink, var(--dist)); stroke-width: 0.45; }
	.b-near { stroke: var(--ink, var(--sec)); stroke-width: 0.5; }
	.junction { fill: var(--ink, var(--sec)); }
	.ic { fill: var(--bg); stroke: var(--sec); stroke-width: 0.45; }
	.pipe { stroke: var(--dist); stroke-width: 0.45; }
	/* the riders: hairline figures a step brighter than the land, a tiny lamp, tyre tracks fading into the sand */
	.frame, .wheel { stroke: var(--pri2); stroke-width: 0.55; }
	.wheel { fill: var(--bg); }
	.lamp { fill: var(--amber); }
	.beam { fill: var(--amber); opacity: 0.09; }
	.tyre { stroke: var(--dist); stroke-width: 0.5; stroke-dasharray: 0.6 2.2; }
	.tyre.fresh { stroke: var(--sec); }
	.via { stroke: var(--ink, var(--sec)); stroke-width: 0.45; }
	.via.mid { stroke: var(--ink, var(--dist)); }
	.pad { fill: var(--bg); stroke: var(--ink, var(--sec)); stroke-width: 0.4; }
	/* the static fire: the bore runs hot from the throat out, exhaust streams over the sand, then it all cools */
	.mouth-hit { fill: transparent; cursor: pointer; }
	.hot, .inner, .inner-warm { transition: stroke 1.8s ease-out; }
	#launch-art.firing .hot { stroke: var(--sun0); transition-duration: 0.2s; }
	#launch-art.firing .inner-warm { stroke: var(--amber); transition-duration: 0.3s; }
	#launch-art.firing .inner { stroke: var(--sun3); transition-duration: 0.5s; }
	/* the jet unrolls out of the mouth on ignition and flickers through the burn */
	.plume { pointer-events: none; transform-box: view-box; }
	.flame, .diamond { opacity: 0; transition: opacity 0.9s ease-in; }
	#launch-art.firing .flame, #launch-art.firing .diamond { opacity: 1; transition: opacity 0.12s ease-out; }
	.fl0 { fill: var(--sun4); opacity: 0.55; }
	.fl1 { fill: var(--sun3); opacity: 0.8; }
	.fl2 { fill: var(--amber); }
	.fl3 { fill: var(--sun0); }
	.diamond { fill: var(--sun0); stroke: var(--amber); stroke-width: 0.5; }
	.streams path { stroke: var(--sun0); stroke-width: 0.5; stroke-dasharray: 14 3 6 4; opacity: 0.7; }
	/* ignition unrolls the jet left to right out of the mouth; nothing in it moves vertically */
	#launch-art.firing .fl { animation: burn 0.18s steps(3, end) infinite alternate; }
	#launch-art.firing .streams path { animation: exhaust 0.5s linear infinite; }
	@keyframes burn { to { opacity: 0.82; } }
	@keyframes exhaust { to { stroke-dashoffset: -27; } }
	/* the launch */
	.nose-hit { fill: transparent; cursor: pointer; }
	.exhaust { opacity: 0; transition: opacity 0.6s; }
	/* solid only in flight, so at rest the rock in front of the cone's foot still shows */
	.rocket-body { fill: var(--bg); stroke: var(--pri2); stroke-width: 0.55; opacity: 0; }
	#launch-art.launching .rocket-body { opacity: 1; }
	#launch-art.launching .exhaust { opacity: 1; transition-duration: 0.1s; }
	#launch-art.launching .exhaust .fl { animation: burn 0.14s steps(3, end) infinite alternate; }
	#launch-art :global(.trail-hot) { fill: none; stroke: var(--sun0); stroke-width: 1.1; stroke-linecap: round; }
	#launch-art :global(.burnout) { fill: none; stroke: var(--sun0); stroke-width: 0.8; transform-box: fill-box; transform-origin: center; }
	#launch-art :global(.new-star) { fill: var(--amber); animation: led 3.4s steps(1, end) infinite; }
	/* the launch cloud, and the riders lost in it until it clears */
	.art-wrap > :global(canvas.cloud) { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
	#launch-art :global(.puff) { fill: var(--bg); stroke: var(--sec); stroke-width: 0.55; }
	#launch-art :global(.puff.lit) { stroke: var(--sun3); }
	#launch-art :global(.puff.far) { stroke: var(--dist); }
	#launch-art :global(.puff.trail) { stroke: var(--pri2); }
	#launch-art :global(.puff-st.lit) { fill: var(--amber); }
	.riders { transition: opacity 1.2s; }
	#launch-art.smoky .riders { opacity: 0; }
	/* what the burn throws about: copper and rock off the cliff, dust where it lands, sparks out of the jet */
	#launch-art :global(.frag) { fill: none; stroke: var(--pri2); stroke-width: 0.6; stroke-linecap: round; }
	#launch-art :global(.frag.chip) { fill: var(--bg); stroke: var(--sec); }
	#launch-art :global(.dust) { fill: none; stroke: var(--dist); stroke-width: 0.5; }
	#launch-art :global(.spark) { stroke: var(--sun0); stroke-width: 1; stroke-linecap: round; }
	/* the probe's copies take the warm tone through --ink, which crosses into <use> where class colours would not */
	.probe { --ink: var(--amber); opacity: 0; transition: opacity 0.45s ease-out; pointer-events: none; }
	#launch-art.probing .probe { opacity: 1; transition-duration: 0.15s; }

	/* telemetry comets: runtime clones carry no scoping attribute */
	.route { stroke: none; }
	#launch-art :global(.comet) { fill: none; stroke: var(--amber); stroke-linecap: round; }
	#launch-art :global(.comet.sky) { stroke: var(--pri2); }

	#launch-art:not(.is-live) * { animation-play-state: paused; }

	@keyframes twinkle { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
	@keyframes led { 0%, 100% { opacity: 0.55; } 92% { opacity: 1; } 95% { opacity: 0.3; } }
	@keyframes wake { 0%, 70%, 100% { stroke: var(--faint); } 80%, 86% { stroke: var(--dist); } }

	@media (prefers-reduced-motion: reduce) {
		#launch-art * { animation: none !important; }
	}
</style>

<script>
	import { STEP, pose, trail } from '../lib/footerRide';

	const wrap = document.getElementById('launch-art');
	if (wrap) {
		const W = 1920, H = 660, MOBILE = 860; // the engine's mouth and the riders' lap hold the frame on a phone
		const svgs = [...wrap.querySelectorAll<SVGSVGElement>('svg.lyr')];
		// narrow screens crop to the mouth of the engine rather than squeezing the whole range in
		const frame = () => {
			const cw = wrap.clientWidth, ch = wrap.clientHeight;
			if (cw >= 640) return svgs.forEach((s) => s.setAttribute('viewBox', `0 0 ${W} ${H}`));
			const y0 = 40, vw = ((H - y0) * cw) / ch, x0 = Math.max(0, Math.min(W - vw, MOBILE - vw / 2));
			for (const s of svgs) s.setAttribute('viewBox', `${x0.toFixed(1)} ${y0} ${vw.toFixed(1)} ${H - y0}`);
		};
		frame();
		new ResizeObserver(frame).observe(wrap);
		new IntersectionObserver(([e]) => wrap.classList.toggle('near', e.isIntersecting), { rootMargin: '300px' }).observe(wrap);

		// the probe light follows the pointer over the land; a tap lights it briefly
		const land = svgs.at(-1)!, probe = wrap.querySelector('#probe')!, probeMask = wrap.querySelector('#probe-mask')!, pt = land.createSVGPoint();
		let pr = 92;
		// the mask region follows the circle, so a move repaints that square and not the whole board
		const setProbe = (x: number | null, y: number | null, r = pr) => {
			pr = r;
			if (x !== null && y !== null) (probe.setAttribute('cx', x.toFixed(1)), probe.setAttribute('cy', y.toFixed(1)));
			const cx = +probe.getAttribute('cx')!, cy = +probe.getAttribute('cy')!;
			probe.setAttribute('r', String(r));
			for (const [k, v] of [['x', cx - r], ['y', cy - r], ['width', 2 * r], ['height', 2 * r]] as const) probeMask.setAttribute(k, v.toFixed(1));
		};
		let pending: PointerEvent | null = null, fade = 0;
		const aim = () => {
			const m = land.getScreenCTM();
			if (pending && m) {
				pt.x = pending.clientX;
				pt.y = pending.clientY;
				const p = pt.matrixTransform(m.inverse());
				setProbe(p.x, p.y);
			}
			pending = null;
		};
		let firing = false;
		wrap.addEventListener('pointermove', (e) => {
			if (firing) return;
			if (!pending) requestAnimationFrame(aim);
			pending = e;
			wrap.classList.add('probing');
			clearTimeout(fade);
			if (e.pointerType !== 'mouse') fade = setTimeout(() => wrap.classList.remove('probing'), 1400);
		});
		wrap.addEventListener('pointerdown', (e) => {
			if (firing) return;
			pending = e;
			aim();
			wrap.classList.add('probing');
			clearTimeout(fade);
			fade = setTimeout(() => wrap.classList.remove('probing'), 1400);
		});
		wrap.addEventListener('pointerleave', () => firing || wrap.classList.remove('probing'));

		// the burn is violent: a jolt at ignition settling into a rumble, the cliff round the mouth crumbling, sparks
		// thrown out with the jet
		const debris = wrap.querySelector<SVGGElement>('.debris')!, cliff: number[][] = JSON.parse(debris.dataset.cliff!);
		const [mx, my, mr] = debris.dataset.mouth!.split(' ').map(Number), rnd = (a: number, b: number) => a + Math.random() * (b - a);
		const BITS = ['M-6 0h7l4 4', 'M0 -5v6l4 4', 'M-5 0h10', 'M-4 -3h6l3 3'], CHIP = 'M-3.6 -2.4L3.2 -3.2L2 3.2Z', VIA = 'M-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0';
		const spawn = (cls: string, d: string) => {
