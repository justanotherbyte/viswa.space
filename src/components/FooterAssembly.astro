---
// Renders one foreground assembly from footerLab: screen-space paths, plus groups mapped onto the board plane for silkscreen, pads and markings.
import type { Item } from '../lib/footerLab';

interface Props {
	items: Item[];
	label: string;
}
const { items, label } = Astro.props;
---

<g class="assembly" data-name={label}>
	{items.map((it) =>
		it.t === 'path' ? (
			<path d={it.d} class={it.c} id={it.id} />
		) : (
			<g transform={it.m} class={`plane ${it.c ?? ''}`}>
				{it.kids.map((k) =>
					k.t === 'text' ? <text x={k.x} y={k.y} font-size={k.s}>{k.v}</text> : <path d={k.d} class={k.c} id={k.id} vector-effect="non-scaling-stroke" />,
				)}
			</g>
		),
	)}
</g>

<style is:global>
	/* global because the assembly paths are rendered by this component but themed by the artwork's palette; every rule stays under #launch-art */
	#launch-art .assembly .side { fill: var(--side); stroke: var(--sec); stroke-width: 0.6; stroke-linejoin: round; }
	#launch-art .assembly .top { fill: var(--bg); stroke: var(--sec); stroke-width: 0.6; stroke-linejoin: round; }
	#launch-art .assembly .pcb.top { fill: var(--pcb); stroke: var(--pri2); stroke-width: 0.8; }
	#launch-art .assembly .pcb.side { stroke: var(--pri2); }
	#launch-art .assembly .module.top { stroke: var(--sec); }
	#launch-art .assembly .tall.top, #launch-art .assembly .header.top, #launch-art .assembly .display.top { stroke: var(--pri2); }
	#launch-art .assembly .metal.top { stroke: var(--pri2); fill: var(--side); }
	#launch-art .assembly .fpga.top, #launch-art .assembly .lid.top { stroke: var(--pri); stroke-width: 0.8; }
	#launch-art .assembly .fpga.side, #launch-art .assembly .lid.side { stroke: var(--pri2); }
	#launch-art .assembly .small.top { fill: var(--sec); stroke: none; }
	#launch-art .assembly .opening { fill: var(--screen); stroke: var(--sec); stroke-width: 0.5; }
	#launch-art .assembly .lamp.blue { fill: var(--blue); stroke: none; }
	#launch-art .assembly .lamp.amber { fill: var(--amber); stroke: none; }
	#launch-art .assembly .blink { animation: fa-blink 0.9s steps(1, end) infinite; }
	#launch-art .assembly .trace { stroke: var(--dist); stroke-width: 0.8; fill: none; stroke-linejoin: round; }
	#launch-art .assembly .pair { stroke: var(--sec); stroke-width: 0.6; fill: none; }
	#launch-art .assembly .power { stroke: var(--dist); stroke-width: 2.2; fill: none; stroke-linecap: round; }
	#launch-art .assembly .rf { stroke: var(--sec); stroke-width: 1.4; fill: none; }
	#launch-art .assembly .leader { stroke: var(--sec); stroke-width: 0.5; stroke-dasharray: 1.4 1.6; fill: none; }
	#launch-art .assembly .plane path { fill: none; stroke-width: 0.6; }
	#launch-art .assembly .plane text { fill: var(--sec); stroke: none; }
	#launch-art .assembly .silk text { fill: var(--pri2); }
	#launch-art .assembly .mark text { fill: var(--sec); }
	#launch-art .assembly .lid-mark text { fill: var(--pri2); }
	#launch-art .assembly .plane .mhole { stroke: var(--sec); }
	#launch-art .assembly .plane .keepout { stroke: var(--dist); stroke-dasharray: 2 3; }
	#launch-art .assembly .plane .silk { stroke: var(--pri2); }
	#launch-art .assembly .plane .bga { stroke: var(--sec); }
	#launch-art .assembly .plane .via { stroke: var(--sec); fill: var(--pcb); }
	#launch-art .assembly .plane .hole { fill: var(--screen); stroke: var(--sec); stroke-width: 0.4; }
	#launch-art .assembly .plane .cap { fill: var(--side); stroke: var(--pri2); }
	#launch-art .assembly .plane .screw, #launch-art .assembly .plane .pins { stroke: var(--pri2); }
	#launch-art .assembly .plane .perf { fill: var(--dist); stroke: none; }
	#launch-art .assembly .plane .dotmark { fill: var(--pri2); stroke: none; }
	#launch-art .assembly .plane .seg { stroke: var(--faint); stroke-width: 1.5; stroke-linecap: round; }
	#launch-art .assembly .plane .seg.lit { stroke: var(--amber); }
	#launch-art .assembly .knob { fill: var(--pri2); stroke: none; transition: transform 300ms var(--ease-out, ease-out); }
	#launch-art .assembly .knob.on { transform: translate(2.7px, -2.4px); }
	#launch-art .assembly .led.top { fill: var(--dist); stroke: none; }
	#launch-art .assembly .led.side { fill: var(--side); stroke: none; }
	#launch-art .assembly .led.done.top, #launch-art .assembly .led.on-blue.top { fill: var(--blue); }
	#launch-art .assembly #gs-arm.lit { fill: var(--amber); }
	#launch-art .assembly #ld4, #launch-art .assembly #ld5, #launch-art .assembly #ld6, #launch-art .assembly #ld7 { animation: fa-scan 2.4s linear infinite; }
	#launch-art .assembly #ld5 { animation-delay: -2.1s; }
	#launch-art .assembly #ld6 { animation-delay: -1.8s; }
	#launch-art .assembly #ld7 { animation-delay: -1.5s; }
	#launch-art .assembly .rgb.top { animation: fa-rgb 6s steps(1, end) infinite; }
	#launch-art .assembly #rgb1 { animation-delay: -1.5s; }
	#launch-art .assembly #rgb2 { animation-delay: -3s; }
	#launch-art .assembly #rgb3 { animation-delay: -4.5s; }
	#launch-art:not(.is-live) .assembly * { animation-play-state: paused; }

	@keyframes fa-blink { 50% { opacity: 0.15; } }
	@keyframes fa-scan { 0%, 18% { fill: var(--blue); } 30%, 100% { fill: var(--dist); } }
	@keyframes fa-rgb { 0% { fill: var(--amber); } 25% { fill: var(--lav); } 50% { fill: var(--blue); } 75% { fill: var(--dist); } }

	@media (prefers-reduced-motion: reduce) {
		#launch-art .assembly * { animation: none !important; transition: none !important; }
		#launch-art .assembly #ld4, #launch-art .assembly #ld6 { fill: var(--blue); }
		#launch-art .assembly #rgb0 { fill: var(--amber); }
		#launch-art .assembly #rgb2 { fill: var(--lav); }
	}
</style>
