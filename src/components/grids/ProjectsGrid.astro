---
import Section from '../Section.astro';
import ProjectCard from '../cards/ProjectCard.astro';
import { topLevelProjects } from '../../lib/series';

const projects = (await topLevelProjects()).slice(0, 2);
---

<Section id="projects" name="Projects" moreInfo="/projects">
	{
		projects.length > 0 ? (
			<div class="grid md:grid-cols-2 gap-x-2 sm:grid-cols-1 gap-y-2">
				{projects.map((project) => (
					<ProjectCard
						title={project.data.title}
						description={project.data.description}
						image={project.data.image}
						imagePosition={project.data.imagePosition}
						imageFit={project.data.imageFit}
						imageBg={project.data.imageBg}
						readingTime={project.meta}
						slug={project.id}
					/>
				))}
			</div>
		) : (
			<p class="text-zinc-500 dark:text-zinc-400 text-sm italic">
				No projects yet — add some to src/content/projects.
			</p>
		)
	}
</Section>
