---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import ExperienceCard from '../cards/ExperienceCard.astro';

const experiences = (await getCollection('experience'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 2);

const gridCols =
	{ 1: 'md:grid-cols-1', 2: 'md:grid-cols-2' }[experiences.length] ??
	'md:grid-cols-1';
---

<Section id="experience" name="Experience" moreInfo="/experience">
	{
		experiences.length > 0 ? (
			<div class={`grid ${gridCols} gap-x-2 sm:grid-cols-1 gap-y-2`}>
				{experiences.map(({ data: experience }) => (
					<ExperienceCard
						position={experience.position}
						description={experience.description}
						company={experience.companyName}
						companyLink={experience.companyLink}
						startDate={experience.startedAt}
						endDate={experience.endedAt}
						companyLogo={experience.companyIcon}
					/>
				))}
			</div>
		) : (
			<p class="text-zinc-500 dark:text-zinc-400 text-sm italic">
				No experience entries yet — add some to src/content/experience.yaml.
			</p>
		)
	}
</Section>
