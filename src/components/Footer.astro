---
import { Image } from 'astro:assets';
import inBugBlack from '../assets/InBug-Black.png';
import inBugWhite from '../assets/InBug-White.png';
import githubMark from '../assets/github-mark.png';
---

<footer class="container mx-auto max-w-screen-xl p-8">
	<div class="grid grid-cols-3 dark:text-zinc-500">
		<div>© 2026 Viswa Marepalli</div>
		<div class="text-center justify-self-center">
			<a href="/#aboutme" class="hover:text-zinc-300 duration-200">About </a>
			·
			<a
				href="mailto:reachvishm+site@gmail.com"
				class="hover:text-zinc-300 duration-200"
			>
				Contact</a
			>
		</div>
		<div class="flex space-x-3 justify-self-end hidden dark:flex">
			<a href="https://github.com/justanotherbyte" target="_blank">
				<img src="/github-mark-white.svg" alt="GitHub page" class="h-8 w-8" width="24" height="24" />
			</a>
			<a href="https://www.linkedin.com/in/viswa-marepalli/" target="_blank">
				<Image src={inBugWhite} alt="LinkedIn page" class="h-8 w-8" width={24} height={24} />
			</a>
		</div>
		<div class="flex space-x-3 justify-self-end visible dark:hidden">
			<a href="https://github.com/justanotherbyte" target="_blank">
				<Image src={githubMark} alt="GitHub page" class="h-8 w-8" width={24} height={24} />
			</a>
			<a href="https://www.linkedin.com/in/mviswa/" target="_blank">
				<Image src={inBugBlack} alt="LinkedIn page" class="h-8 w-8" width={24} height={24} />
			</a>
		</div>
	</div>
</footer>
