---
interface Props { id: string; name: string; moreInfo?: string; description?: string; }
const { id, name, moreInfo, description } = Astro.props;
const sections: Record<string, [string, string]> = { projects: ['01', 'SELECTED MISSIONS'], experience: ['02', 'FLIGHT HERITAGE'], publications: ['03', 'TRANSMISSIONS'], aboutme: ['04', 'THE HUMAN BEHIND THE HARDWARE'], stack: ['05', 'ONBOARD SYSTEMS'], photography: ['06', 'OBSERVATIONS'] };
const [number, label] = sections[id] ?? ['LOG', 'MISSION ARCHIVE'];
---
<section id={id} class="section-block">
  <div class="section-heading"><div><p class="eyebrow"><span class="section-number">{number} /</span> {label}</p><h2>{name}</h2></div>{moreInfo && <a class="section-more" href={moreInfo}>View all <span aria-hidden="true">↗</span></a>}</div>
  {description && <p class="section-description">{description}</p>}
  <slot />
</section>
