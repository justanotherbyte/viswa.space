---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE } from '../consts';
import { photoInfo } from '../data/photos';
import { breakpoints, rowEnds } from '../lib/gallery';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/photos/*.jpg',
	{ eager: true },
);

const sortedPhotos = Object.entries(photoModules)
	.map(([path, mod]) => {
		const match = path.match(/img_(\d+)\.jpg$/);
		return { index: match ? Number(match[1]) : 0, image: mod.default };
	})
	.sort((a, b) => a.index - b.index);

// Thumbnails render via <Image> directly; the viewer is driven by client JS,
// so its large variants are precomputed here and passed through data attributes.
const photos = await Promise.all(
	sortedPhotos.map(async ({ index, image }, i) => {
		const info = photoInfo[index];
		const date = new Date(info.taken).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
		const full = await getImage({ src: image, width: 2000, widths: [1200, 2000] });
		return {
			...info,
			image,
			date,
			number: String(i + 1).padStart(2, '0'),
			ratio: image.width / image.height,
			full,
		};
	}),
);

// row breaks to render after each photo, one set per breakpoint
const ratios = photos.map((p) => p.ratio);
const breaksAfter = photos.map((_, i) =>
	breakpoints.filter(({ targets }) => rowEnds(ratios, targets).includes(i)).map((b) => b.breakClass),
);
---

<SiteLayout title={`Photography | ${SITE_TITLE}`} description="Photos I've taken.">
	<section id="photography">
		<h1 class="dark:text-white text-xl">My Photography</h1>
		<p class="mt-1 text-zinc-600 dark:text-zinc-400">A collection of photographs taken on an iPhone 14 Pro Max.</p>
		<hr class="mt-4 mb-6 h-0.5 border-t-0 bg-zinc-300 dark:bg-white/10" />

		<div id="gallery" class="flex flex-wrap gap-x-2.5">
			{
				photos.map((p, i) => (
					<Fragment>
						<button
							type="button"
							class="photo group relative mb-2.5 min-w-0 overflow-hidden rounded-md cursor-pointer bg-zinc-200 dark:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
							style={`flex: ${p.ratio * 100} 1 0; aspect-ratio: ${p.image.width} / ${p.image.height}`}
							data-src={p.full.src}
							data-srcset={p.full.srcSet.attribute}
							data-alt={p.alt}
							data-date={p.date}
							data-exposure={p.exposure.join('|')}
							aria-label={`Open photo ${p.number}: ${p.alt}`}
						>
							<Image
								src={p.image}
								alt=""
								widths={[400, 800, 1200]}
								sizes="(min-width: 1024px) 45vw, (min-width: 768px) 60vw, 100vw"
								loading={i < 5 ? 'eager' : 'lazy'}
								class="h-full w-full object-cover duration-300 ease-out motion-safe:group-hover:scale-105"
							/>
							<span class="absolute inset-0 bg-zinc-950/0 duration-300 group-hover:bg-zinc-950/30" />
							<span class="absolute right-2 bottom-2 flex items-center gap-2 px-1.5 py-0.5 text-xs text-zinc-300 bg-zinc-900/75 opacity-0 duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 motion-safe:translate-y-1 motion-safe:group-hover:translate-y-0">
								<time datetime={p.taken}>{p.date}</time>
								<Icon name="expand" class="w-3.5 h-3.5" />
							</span>
						</button>
						{breaksAfter[i].map((cls) => <div class={`brk ${cls}`} />)}
					</Fragment>
				))
			}
		</div>
	</section>

	<dialog
		id="viewer"
		aria-label="Photo viewer"
		class="viewer m-0 h-dvh max-h-none w-screen max-w-none bg-zinc-950 p-0 text-zinc-300 backdrop:bg-transparent"
	>
		<div class="flex h-full flex-col">
			<div class="flex items-center justify-between px-4 py-3 text-xs">
				<span id="viewer-count" aria-live="polite"></span>
				<button id="viewer-close" type="button" aria-label="Close viewer" class="p-2 -m-2 rounded-sm cursor-pointer focus-visible:outline-2 focus-visible:outline-blue-500 hover:text-white duration-200">
					<Icon name="close" class="w-5 h-5" />
				</button>
			</div>
			<div id="viewer-stage" class="relative flex min-h-0 flex-1 items-center justify-center px-4 md:px-16">
				<img id="viewer-img" alt="" sizes="100vw" class="max-h-full max-w-full rounded-md object-contain" />
				<button id="viewer-prev" type="button" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 p-3 cursor-pointer focus-visible:outline-2 focus-visible:outline-blue-500 bg-zinc-950/50 text-zinc-400 hover:text-white duration-200">
					<Icon name="prev" class="w-5 h-5" />
				</button>
				<button id="viewer-next" type="button" aria-label="Next photo" class="absolute right-2 top-1/2 -translate-y-1/2 p-3 cursor-pointer focus-visible:outline-2 focus-visible:outline-blue-500 bg-zinc-950/50 text-zinc-400 hover:text-white duration-200">
					<Icon name="next" class="w-5 h-5" />
				</button>
			</div>
			<p id="viewer-meta" class="flex flex-wrap justify-center gap-x-4 gap-y-1 px-4 py-3 text-xs text-zinc-400"></p>
		</div>
	</dialog>
</SiteLayout>

<style>
	.viewer {
		opacity: 0;
		transition:
			opacity 250ms var(--ease-out),
			display 250ms allow-discrete,
			overlay 250ms allow-discrete;
	}

	.viewer[open] {
		opacity: 1;
	}

	@starting-style {
		.viewer[open] {
			opacity: 0;
		}
	}

	.viewer img {
		transform: scale(0.96);
		transition: transform 250ms var(--ease-out);
	}

	.viewer[open] img {
		transform: scale(1);
	}

	@starting-style {
		.viewer[open] img {
			transform: scale(0.96);
		}
	}

	:global(html:has(dialog[open])) {
		overflow: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.viewer {
			transition-duration: 150ms;
		}

		.viewer img,
		.viewer[open] img {
			transform: none;
		}
	}
</style>

<script>
	const photos = [...document.querySelectorAll<HTMLButtonElement>('#gallery .photo')];
	const viewer = document.getElementById('viewer') as HTMLDialogElement;
	const stage = document.getElementById('viewer-stage')!;
	const img = document.getElementById('viewer-img') as HTMLImageElement;
	const count = document.getElementById('viewer-count')!;
	const meta = document.getElementById('viewer-meta')!;
	const pad = (n: number) => String(n).padStart(2, '0');

	let current = 0;

	// shows the thumbnail straight away, then swaps in the large version once it has decoded
	const show = (i: number) => {
		current = (i + photos.length) % photos.length;
		const photo = photos[current];
		img.srcset = '';
		img.src = photo.querySelector('img')!.currentSrc;
		img.alt = photo.dataset.alt!;
		count.textContent = `${pad(current + 1)} / ${pad(photos.length)}`;
		// the date, then the exposure settings read from the photo's EXIF data
		meta.replaceChildren(
			...[photo.dataset.date!, ...photo.dataset.exposure!.split('|')].map((text, i) => {
				const span = document.createElement('span');
				span.textContent = text;
				if (i === 0) span.className = 'mr-2 text-zinc-200';
				return span;
			}),
		);

		const large = new Image();
		large.sizes = '100vw';
		large.srcset = photo.dataset.srcset!;
		large.src = photo.dataset.src!;
		large
			.decode()
			.then(() => {
				if (photos[current] !== photo) return;
				img.srcset = large.srcset;
				img.src = large.src;
			})
			.catch(() => {});
	};

	photos.forEach((p) =>
		p.addEventListener('click', () => {
			show(photos.indexOf(p));
			viewer.showModal();
		}),
	);

	document.getElementById('viewer-prev')!.addEventListener('click', () => show(current - 1));
	document.getElementById('viewer-next')!.addEventListener('click', () => show(current + 1));
	document.getElementById('viewer-close')!.addEventListener('click', () => viewer.close());

	// clicking anywhere but the photo or a control closes the viewer
	viewer.addEventListener('click', (e) => {
		if (!(e.target as Element).closest('img, button')) viewer.close();
	});

	viewer.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') show(current - 1);
		if (e.key === 'ArrowRight') show(current + 1);
	});

	let touchX = 0;
	stage.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
	stage.addEventListener('touchend', (e) => {
		const dx = e.changedTouches[0].clientX - touchX;
		if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
	});
</script>
