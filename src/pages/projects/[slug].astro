---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { readingTime } from "../../lib/reading-time";
import { tocHeadings } from "../../lib/toc";
import { SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { title, description, date, image, imagePosition, inProgress } =
	project.data;
const { Content, headings } = await render(project);
const toc = tocHeadings(headings);

// Written out explicitly (not `object-${imagePosition}`) so Tailwind's static
// scanner can see the literal class names and actually generate them.
const positionClass = {
	top: "object-top",
	center: "object-center",
	bottom: "object-bottom",
}[imagePosition];
const heroClass = `w-full max-h-96 object-cover ${positionClass} rounded-sm mb-4`;
---

<SiteLayout
	title={`${title} | ${SITE_TITLE}`}
	description={description}
>
	<link
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
	/>
	<link
		rel="stylesheet"
		href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/tokyo-night-dark.min.css"
	/>
	<div>
		{
			typeof image === "string" ? (
				<img src={image} alt={title} class={heroClass} />
			) : (
				<Image src={image} alt={title} width={1200} class={heroClass} />
			)
		}
		<h1 class="dark:text-white text-lg font-semibold mb-2">{title}</h1>
		<p class="text-zinc-600 dark:text-zinc-400 text-sm">
			<FormattedDate date={date} /> · {readingTime(project.body ?? "")}
		</p>
		{
			inProgress && (
				<p class="text-zinc-600 dark:text-zinc-400 text-xs mt-2">
					⚠️
					<span class="">
						This article is in the works, and will soon be
						completed.
					</span>
				</p>
			)
		}

		<hr class="my-4 h-0.5 border-t-0 bg-zinc-300 dark:bg-white/10" />
		{
			toc.length > 0 && (
				<div class="lg:hidden mb-4">
					<TableOfContents headings={toc} variant="inline" />
				</div>
			)
		}
		<div
			class:list={[
				toc.length > 0 &&
					"lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-8",
			]}
		>
			<div
				class="flow-root dark:text-white [&_:is(h1,h2,h3,h4)]:scroll-mt-24 [&>*]:mb-4 [&_img:not(.float-image)]:mx-auto [&_h3]:underline [&_ul]:ml-3 [&_ul]:list-disc [&_a]:text-blue-400 [&_a]:hover:text-blue-600 [&>h1]:text-xl [&>h1]:font-bold [&>h1]:clear-both [&>h2]:text-lg [&>h2]:font-semibold [&>h2]:clear-both [&>p]:dark:text-zinc-300 [&>p]:text-zinc-600"
			>
				<Content />
			</div>
			{
				toc.length > 0 && (
					<aside class="hidden lg:block">
						<div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
							<TableOfContents headings={toc} variant="sidebar" />
						</div>
					</aside>
				)
			}
		</div>
	</div>
	<script
		is:inline
		src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"
	></script>
	<script
		is:inline
		src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/verilog.min.js"
	></script>
	<script is:inline>
		hljs.highlightAll();
	</script>
</SiteLayout>
