---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';
import { topLevelProjects } from '../../lib/series';
import { SITE_TITLE } from '../../consts';

const projects = await topLevelProjects();
---

<SiteLayout title={`Projects | ${SITE_TITLE}`} description="Write-ups on things I've built.">
	<Section id="projects" name="Projects">
		{
			projects.length > 0 ? (
				<div class="grid md:grid-cols-3 gap-x-2 sm:grid-cols-1 gap-y-2">
					{projects.map((project) => (
						<ProjectCard
							title={project.data.title}
							description={project.data.description}
							image={project.data.image}
							imagePosition={project.data.imagePosition}
							imageFit={project.data.imageFit}
							imageBg={project.data.imageBg}
							readingTime={project.meta}
							slug={project.id}
						/>
					))}
				</div>
			) : (
				<p class="text-zinc-500 dark:text-zinc-400 text-sm italic">
					No project write-ups yet — add some to src/content/projects.
				</p>
			)
		}
	</Section>
</SiteLayout>
