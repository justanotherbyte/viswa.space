---
import SiteLayout from '../layouts/SiteLayout.astro';
import About from '../components/About.astro';
import ExperienceGrid from '../components/grids/ExperienceGrid.astro';
import ProjectsGrid from '../components/grids/ProjectsGrid.astro';
import PublicationsGrid from '../components/grids/PublicationsGrid.astro';
import StackGrid from '../components/grids/StackGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION} twitterCard="summary">
	<About />
	<br />
	<ExperienceGrid />
	<br />
	<ProjectsGrid />
	<br />
	<PublicationsGrid />
	<br />
	<StackGrid />
</SiteLayout>
